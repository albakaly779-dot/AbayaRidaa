# Telegram BotFather token. Never commit the real value.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs that receive each confirmed order.
# Use the bot's "معرفة رقم المحادثة" button to discover your ID.
ADMIN_CHAT_IDS=

# Persistent local storage. Use a mounted volume in production.
DATA_DIR=./data
POLL_TIMEOUT=30
LOG_LEVEL=INFO
